{
    "name": "youvision/think-pinyin",
    "description": "基于 PSCWS4 分词与 overtrue/pinyin 的中文转拼音工具，适配 ThinkPHP 8",
    "type": "library",
    "keywords": [
        "thinkphp",
        "pinyin",
        "pscws4",
        "slug",
        "chinese"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^8.0",
        "overtrue/pinyin": "^6.0",
        "youvision/think-pscws4": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkPinyin\\": "src/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkPinyin\\Service"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}